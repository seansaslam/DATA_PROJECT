# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env
#
# These seed the connection profiles the FIRST time the app runs. After that the
# profiles live in app_state.sqlite3 and are edited on the Connections page.

CCT_SECRET_KEY=change-me
CCT_DEBUG=1
CCT_ALLOWED_HOSTS=*
CCT_APP_PORT=5001
CCT_CSRF_HOSTS=localhost,127.0.0.1

# Source SQL Server / Azure SQL reached by all three simulated systems.
# CCT_DB_TYPE is one of: sqlserver | azuresql | azuremi
CCT_DB_TYPE=sqlserver
CCT_DB_SERVER=your-sql-host
CCT_DB_PORT=1433
CCT_DB_USER=your-sql-user
CCT_DB_PASSWORD=your-sql-password
CCT_DB_EXTRA_OPTIONS=
